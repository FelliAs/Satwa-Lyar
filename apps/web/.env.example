# Environment Variables - JSN-EDU Web (Next.js)
# Copy file ini menjadi .env.local dan isi dengan nilai asli

# Base URL backend REST API JSN-EDU
# Lokal: http://localhost:5000
# Deploy: https://<nama-project-api>.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# Analytics page-view; default false di local/dev, true di production
NEXT_PUBLIC_ENABLE_ANALYTICS=false
