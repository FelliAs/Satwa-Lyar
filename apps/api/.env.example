# Environment Variables - SATWA LYAR API
# Copy file ini menjadi .env dan isi dengan nilai asli

# ================================
# SERVER
# ================================
PORT=5000
NODE_ENV=development

# ================================
# DATABASE - MariaDB Cloud
# ================================
DB_HOST=your-mariadb-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=satwa_lyar

# ================================
# IDENTITAS GUEST
# Cookie identitas guest (tracking, bukan token akses admin)
# ================================
GUEST_COOKIE_NAME=satwa_guest
# strict | lax | none  (gunakan none + HTTPS jika frontend & API berbeda domain)
GUEST_COOKIE_SAMESITE=lax

# ================================
# JWT
# ================================
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ================================
# CLOUDFLARE R2
# ================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=satwa-lyar
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ================================
# UPSTASH REDIS (opsional - cache performa tinggi)
# Nama standar Upstash. Alias lama REDIS_URL / REDIS_TOKEN juga didukung.
# ================================
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ================================
# CORS
# ================================
CORS_ORIGIN=http://localhost:3000
